diff --git a/lib/canvas-worker.ts b/lib/canvas-worker.ts
new file mode 100644
index 0000000..f17f499
--- /dev/null
+++ b/lib/canvas-worker.ts
@@ -0,0 +1,67 @@
+// This file runs inside a Worker, not on the main thread. Each worker in
+// the pool (see workerPool.ts) gets its own instance, so N workers really
+// do use N cores in parallel — unlike calling canvas.toBlob() N times on
+// the main thread, which only ever uses one core no matter how many
+// "concurrent" promises are in flight.
+
+export type CanvasTask =
+  | { kind: "convert"; format: string; quality: number }
+  | { kind: "compress"; format: string; quality: number; maxW: number }
+  | { kind: "resize"; format: string; pct: number };
+
+interface Req {
+  id: number;
+  file: File;
+  task: CanvasTask;
+}
+interface Res {
+  id: number;
+  ok: boolean;
+  blob?: Blob;
+  error?: string;
+}
+
+self.onmessage = async (e: MessageEvent<Req>) => {
+  const { id, file, task } = e.data;
+  try {
+    const bitmap = await createImageBitmap(file);
+    let w = bitmap.width;
+    let h = bitmap.height;
+    let format = "image/png";
+    let quality = 0.92;
+
+    if (task.kind === "compress") {
+      format = task.format;
+      quality = task.quality;
+      if (task.maxW && bitmap.width > task.maxW) {
+        const scale = task.maxW / bitmap.width;
+        w = Math.round(bitmap.width * scale);
+        h = Math.round(bitmap.height * scale);
+      }
+    } else if (task.kind === "resize") {
+      format = task.format;
+      w = Math.max(1, Math.round((bitmap.width * task.pct) / 100));
+      h = Math.max(1, Math.round((bitmap.height * task.pct) / 100));
+    } else {
+      format = task.format;
+    }
+
+    const canvas = new OffscreenCanvas(w, h);
+    const ctx = canvas.getContext("2d") as OffscreenCanvasRenderingContext2D;
+    if (format === "image/jpeg") {
+      // JPEG has no alpha channel — transparent pixels would otherwise
+      // turn black instead of white.
+      ctx.fillStyle = "#fff";
+      ctx.fillRect(0, 0, w, h);
+    }
+    ctx.drawImage(bitmap, 0, 0, w, h);
+    bitmap.close();
+
+    const blob = await canvas.convertToBlob({ type: format, quality });
+    const res: Res = { id, ok: true, blob };
+    (self as unknown as { postMessage: (m: Res) => void }).postMessage(res);
+  } catch (err) {
+    const res: Res = { id, ok: false, error: err instanceof Error ? err.message : "Worker failed" };
+    (self as unknown as { postMessage: (m: Res) => void }).postMessage(res);
+  }
+};
diff --git a/lib/workerPool.ts b/lib/workerPool.ts
new file mode 100644
index 0000000..1c90f93
--- /dev/null
+++ b/lib/workerPool.ts
@@ -0,0 +1,91 @@
+"use client";
+
+import type { CanvasTask } from "./canvas-worker";
+
+let supported: boolean | null = null;
+
+/** Feature-detects OffscreenCanvas + module Worker support once, and caches the result. */
+export function workersSupported(): boolean {
+  if (supported !== null) return supported;
+  supported =
+    typeof Worker !== "undefined" &&
+    typeof OffscreenCanvas !== "undefined";
+  return supported;
+}
+
+class CanvasWorkerPool {
+  private workers: Worker[] = [];
+  private next = 0;
+  private pending = new Map<number, { resolve: (b: Blob) => void; reject: (e: Error) => void }>();
+  private counter = 0;
+
+  constructor(size: number) {
+    for (let i = 0; i < size; i++) {
+      const w = new Worker(new URL("./canvas-worker.ts", import.meta.url), { type: "module" });
+      w.onmessage = (e: MessageEvent<{ id: number; ok: boolean; blob?: Blob; error?: string }>) => {
+        const { id, ok, blob, error } = e.data;
+        const p = this.pending.get(id);
+        if (!p) return;
+        this.pending.delete(id);
+        if (ok && blob) p.resolve(blob);
+        else p.reject(new Error(error || "Worker failed"));
+      };
+      this.workers.push(w);
+    }
+  }
+
+  run(file: File, task: CanvasTask): Promise<Blob> {
+    const id = this.counter++;
+    const worker = this.workers[this.next];
+    this.next = (this.next + 1) % this.workers.length;
+    return new Promise((resolve, reject) => {
+      this.pending.set(id, { resolve, reject });
+      worker.postMessage({ id, file, task });
+    });
+  }
+
+  terminate() {
+    this.workers.forEach((w) => w.terminate());
+    this.workers = [];
+    this.pending.clear();
+  }
+}
+
+let pool: CanvasWorkerPool | null = null;
+let poolSize = 0;
+
+/** Lazily creates (or resizes) a shared worker pool sized to the device's cores. */
+function getPool(size: number): CanvasWorkerPool {
+  if (!pool || poolSize !== size) {
+    pool?.terminate();
+    pool = new CanvasWorkerPool(size);
+    poolSize = size;
+  }
+  return pool;
+}
+
+export function idealWorkerCount(): number {
+  const cores = typeof navigator !== "undefined" ? navigator.hardwareConcurrency || 4 : 4;
+  // Leave one core free for the main/UI thread.
+  return Math.max(2, Math.min(6, cores - 1));
+}
+
+/**
+ * Runs a canvas task (compress/resize/convert) on a pooled worker so bulk
+ * batches use real separate cores. Falls back to the caller-supplied
+ * main-thread implementation on browsers without OffscreenCanvas
+ * (older Safari) so nothing breaks there.
+ */
+export async function runCanvasTask(
+  file: File,
+  task: CanvasTask,
+  fallback: () => Promise<Blob>
+): Promise<Blob> {
+  if (!workersSupported()) return fallback();
+  try {
+    const p = getPool(idealWorkerCount());
+    return await p.run(file, task);
+  } catch {
+    return fallback();
+  }
+}
